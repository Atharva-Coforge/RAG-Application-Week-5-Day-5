# Copy this file to .env and fill in local values.
# .env is gitignored and must not be committed.
# Runtime code loads these names through Settings.

# Selected embedding model (ADR-001). MiniLM vectors are 384-d.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Selected generation provider is local Ollama (ADR-003).
OLLAMA_HOST=http://host.docker.internal:11434
GENERATION_MODEL=qwen3:8b

# Selected default store is pgvector (ADR-002). Allowed: chroma, faiss, pgvector.
VECTOR_STORE=pgvector

# Required only when VECTOR_STORE=pgvector. Replace with local credentials.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DBNAME
